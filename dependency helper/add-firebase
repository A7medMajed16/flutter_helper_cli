#!/bin/bash
# ============================================================
#  add-firebase — Interactive CLI to add Firebase packages
#  Run from any Dart/Flutter project directory.
# ============================================================

set -e

# ── Colors ──────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

info()    { echo -e "${CYAN}ℹ ${NC}$1"; }
success() { echo -e "${GREEN}✅ ${NC}$1"; }
warn()    { echo -e "${YELLOW}⚠️  ${NC}$1"; }
error()   { echo -e "${RED}❌ ${NC}$1"; exit 1; }

targetPath="${PWD}"

# Check if we are in a Flutter project
if [ ! -f "$targetPath/pubspec.yaml" ]; then
    error "No pubspec.yaml found. Please run this command at the root of a Flutter project."
fi

items=(
    "C|Core"
    "I|firebase_core"
    
    "C|Authentication"
    "I|firebase_auth"
    "I|firebase_app_check"
    "I|firebase_ui_auth"
    "I|firebase_ui_oauth_google"
    "I|firebase_ui_oauth_facebook"
    "I|firebase_ui_oauth_apple"
    "I|firebase_ui_oauth_twitter"

    "C|Database & Storage"
    "I|cloud_firestore"
    "I|firebase_database"
    "I|firebase_storage"
    "I|firebase_ui_firestore"
    "I|firebase_ui_database"

    "C|Messaging & Analytics"
    "I|firebase_messaging"
    "I|firebase_analytics"
    "I|firebase_in_app_messaging"

    "C|Performance & Quality"
    "I|firebase_crashlytics"
    "I|firebase_performance"
    "I|firebase_remote_config"

    "C|Functions & Utilities"
    "I|cloud_functions"
    "I|firebase_dynamic_links"
    "I|firebase_app_installations"
    "I|firebase_ml_model_downloader"
)

selected=()
for i in "${!items[@]}"; do
    selected[$i]=0
done

cursor=1

move_cursor() {
    local dir=$1
    local new_cursor=$cursor
    while true; do
        new_cursor=$((new_cursor + dir))
        if [ $new_cursor -lt 0 ] || [ $new_cursor -ge ${#items[@]} ]; then
            break
        fi
        if [[ "${items[$new_cursor]}" == "I|"* ]]; then
            cursor=$new_cursor
            break
        fi
    done
}

render_menu() {
    # Dynamically compute visible window from terminal height
    local term_lines
    term_lines=$(tput lines 2>/dev/null || echo 24)
    # Reserve lines for: header(1) + top indicator(1) + bottom indicator(1)
    local max_items=$((term_lines - 3))
    if [ "$max_items" -lt 3 ]; then max_items=3; fi
    if [ "$max_items" -gt ${#items[@]} ]; then max_items=${#items[@]}; fi

    local start_idx=0
    local end_idx=$max_items

    if [ ${#items[@]} -gt "$max_items" ]; then
        # Center the window on the cursor where possible
        start_idx=$((cursor - max_items / 2))
        if [ "$start_idx" -lt 0 ]; then
            start_idx=0
        fi
        end_idx=$((start_idx + max_items))
        if [ "$end_idx" -gt ${#items[@]} ]; then
            end_idx=${#items[@]}
            start_idx=$((end_idx - max_items))
        fi
    fi

    # Always jump to top-left of screen and redraw everything
    tput cup 0 0

    # Re-print header
    echo -e "${BOLD}Select Firebase packages to add (Space to toggle, Enter to confirm, Up/Down to move):${NC}\033[K"

    if [ "$start_idx" -gt 0 ]; then
        echo -e "  ${CYAN}↑ ...more above...${NC}\033[K"
    else
        echo -e "\033[K"
    fi

    for (( i=$start_idx; i<$end_idx; i++ )); do
        IFS="|" read -r type name <<< "${items[$i]}"
        if [ "$type" == "C" ]; then
            echo -e "${BOLD}${CYAN}--- $name ---${NC}\033[K"
        else
            local check=" "
            if [ "${selected[$i]}" -eq 1 ]; then
                check="${GREEN}✓${NC}"
            fi
            if [ "$i" -eq "$cursor" ]; then
                echo -e "${GREEN}> [${check}${GREEN}] $name${NC}\033[K"
            else
                echo -e "  [${check}] $name\033[K"
            fi
        fi
    done

    if [ "$end_idx" -lt ${#items[@]} ]; then
        echo -e "  ${CYAN}↓ ...more below...${NC}\033[K"
    else
        echo -e "\033[K"
    fi

    # Clear everything below to remove stale lines
    echo -en "\033[J"
}

# Cleanup: restore cursor and exit alternate screen
cleanup() {
    tput cnorm 2>/dev/null
    tput rmcup 2>/dev/null
}
trap cleanup EXIT

# Enter alternate screen buffer (like vim/fzf) — gives us a clean screen
tput smcup
tput civis
tput clear

while true; do
    render_menu

    IFS= read -rsn1 key

    if [[ $key == $'\x1b' ]]; then
        read -rsn2 key2
        if [[ $key2 == "[A" ]]; then
            move_cursor -1
        elif [[ $key2 == "[B" ]]; then
            move_cursor 1
        fi
    elif [[ "$key" == "" ]]; then
        break
    elif [[ "$key" == " " ]]; then
        if [ "${selected[$cursor]}" -eq 1 ]; then
            selected[$cursor]=0
        else
            selected[$cursor]=1
        fi
    fi
done

packages_to_add=()
for i in "${!items[@]}"; do
    IFS="|" read -r type name <<< "${items[$i]}"
    if [ "$type" == "I" ] && [ "${selected[$i]}" -eq 1 ]; then
        packages_to_add+=("$name")
    fi
done

echo ""
if [ ${#packages_to_add[@]} -eq 0 ]; then
    warn "No packages selected."
    exit 0
fi

info "Adding ${#packages_to_add[@]} package(s)..."
echo -e "  ${CYAN}${packages_to_add[*]}${NC}"

if flutter pub add "${packages_to_add[@]}"; then
    echo ""
    success "Successfully added Firebase packages!"
else
    echo ""
    error "Failed to add Firebase packages."
fi
