#!/bin/bash
# ============================================================
#  add-dependencies — Interactive CLI to add Flutter packages
#  Run from any Dart/Flutter project directory.
# ============================================================

set -e

# ── Colors ──────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

info()    { echo -e "${CYAN}ℹ ${NC}$1"; }
success() { echo -e "${GREEN}✅ ${NC}$1"; }
warn()    { echo -e "${YELLOW}⚠️  ${NC}$1"; }
error()   { echo -e "${RED}❌ ${NC}$1"; exit 1; }

targetPath="${PWD}"

# Check if we are in a Flutter project
if [ ! -f "$targetPath/pubspec.yaml" ]; then
    error "No pubspec.yaml found. Please run this command at the root of a Flutter project."
fi

items=(
    "C|Architecture & State Management"
    "I|bloc"
    "I|flutter_bloc"
    "I|get_it"
    "I|injectable"
    "D|build_runner"
    "D|injectable_generator"

    "C|Networking & Data"
    "I|dio"
    "I|pretty_dio_logger"
    "I|shared_preferences"
    "I|flutter_secure_storage"
    "I|freezed_annotation"

    "C|Navigation & Routing"
    "I|auto_route"
    "D|auto_route_generator"

    "C|UI & Assets"
    "I|cached_network_image"
    "I|flutter_cache_manager"
    "I|flutter_screenutil"
    "I|flutter_svg"
    "I|shimmer"
    "I|toastification"
    "I|liquid_pull_to_refresh"
    "I|lottie"
    "I|cupertino_icons"

    "C|Media & Files"
    "I|image"
    "I|image_picker"
    "I|image_cropper"
    "I|file_picker"
    "I|video_player"
    "I|chewie"
    "I|just_audio"

    "C|Utilities & Platform"
    "I|dartz"
    "I|equatable"
    "I|easy_localization"
    "I|path"
    "I|path_provider"
    "I|permission_handler"
    "I|url_launcher"
    "I|share_plus"
    "I|pinput"
    "I|table_calendar"
    "I|hijri"
    "I|ntp"

    "C|Environment & Tooling"
    "I|flutter_dotenv"
    "I|flutter_launcher_icons"
    "I|flutter_native_splash"
    "I|flutter_local_notifications"
    "I|flutter_lints"
    "D|flutter_gen_runner"
)

selected=()
for i in "${!items[@]}"; do
    if [[ "${items[$i]}" == "I|"* ]] || [[ "${items[$i]}" == "D|"* ]]; then
        selected[$i]=1
    else
        selected[$i]=0
    fi
done

cursor=1

move_cursor() {
    local dir=$1
    local new_cursor=$cursor
    while true; do
        new_cursor=$((new_cursor + dir))
        if [ $new_cursor -lt 0 ] || [ $new_cursor -ge ${#items[@]} ]; then
            break
        fi
        if [[ "${items[$new_cursor]}" == "I|"* ]] || [[ "${items[$new_cursor]}" == "D|"* ]]; then
            cursor=$new_cursor
            break
        fi
    done
}

render_menu() {
    # Dynamically compute visible window from terminal height
    local term_lines
    term_lines=$(tput lines 2>/dev/null || echo 24)
    # Reserve lines for: header(1) + top indicator(1) + bottom indicator(1)
    local max_items=$((term_lines - 3))
    if [ "$max_items" -lt 3 ]; then max_items=3; fi
    if [ "$max_items" -gt ${#items[@]} ]; then max_items=${#items[@]}; fi

    local start_idx=0
    local end_idx=$max_items

    if [ ${#items[@]} -gt "$max_items" ]; then
        # Center the window on the cursor where possible
        start_idx=$((cursor - max_items / 2))
        if [ "$start_idx" -lt 0 ]; then
            start_idx=0
        fi
        end_idx=$((start_idx + max_items))
        if [ "$end_idx" -gt ${#items[@]} ]; then
            end_idx=${#items[@]}
            start_idx=$((end_idx - max_items))
        fi
    fi

    # Always jump to top-left of screen and redraw everything
    tput cup 0 0

    # Re-print header
    echo -e "${BOLD}Select packages to add (Space to toggle, Enter to confirm, Up/Down to move):${NC}\033[K"

    if [ "$start_idx" -gt 0 ]; then
        echo -e "  ${CYAN}↑ ...more above...${NC}\033[K"
    else
        echo -e "\033[K"
    fi

    for (( i=$start_idx; i<$end_idx; i++ )); do
        IFS="|" read -r type name <<< "${items[$i]}"
        if [ "$type" == "C" ]; then
            echo -e "${BOLD}${CYAN}--- $name ---${NC}\033[K"
        else
            local check=" "
            if [ "${selected[$i]}" -eq 1 ]; then
                check="${GREEN}✓${NC}"
            fi
            if [ "$i" -eq "$cursor" ]; then
                echo -e "${GREEN}> [${check}${GREEN}] $name${YELLOW} $([ "$type" == "D" ] && echo '(dev)') ${NC}\033[K"
            else
                echo -e "  [${check}] $name${YELLOW} $([ "$type" == "D" ] && echo '(dev)') ${NC}\033[K"
            fi
        fi
    done

    if [ "$end_idx" -lt ${#items[@]} ]; then
        echo -e "  ${CYAN}↓ ...more below...${NC}\033[K"
    else
        echo -e "\033[K"
    fi

    # Clear everything below to remove stale lines
    echo -en "\033[J"
}

# Cleanup: restore cursor and exit alternate screen
cleanup() {
    tput cnorm 2>/dev/null
    tput rmcup 2>/dev/null
}
trap cleanup EXIT

# Enter alternate screen buffer (like vim/fzf) — gives us a clean screen
tput smcup
tput civis
tput clear

while true; do
    render_menu

    IFS= read -rsn1 key

    if [[ $key == $'\x1b' ]]; then
        read -rsn2 key2
        if [[ $key2 == "[A" ]]; then
            move_cursor -1
        elif [[ $key2 == "[B" ]]; then
            move_cursor 1
        fi
    elif [[ "$key" == "" ]]; then
        break
    elif [[ "$key" == " " ]]; then
        if [ "${selected[$cursor]}" -eq 1 ]; then
            selected[$cursor]=0
        else
            selected[$cursor]=1
        fi
    fi
done

packages_to_add=()
dev_packages_to_add=()
for i in "${!items[@]}"; do
    IFS="|" read -r type name <<< "${items[$i]}"
    if [ "${selected[$i]}" -eq 1 ]; then
        if [ "$type" == "I" ]; then
            packages_to_add+=("$name")
        elif [ "$type" == "D" ]; then
            dev_packages_to_add+=("$name")
        fi
    fi
done

echo ""
if [ ${#packages_to_add[@]} -eq 0 ] && [ ${#dev_packages_to_add[@]} -eq 0 ]; then
    warn "No packages selected."
    exit 0
fi

if [ ${#packages_to_add[@]} -gt 0 ]; then
    info "Adding ${#packages_to_add[@]} standard package(s)..."
    if flutter pub add "${packages_to_add[@]}"; then
        success "Standard packages added successfully!"
    else
        error "Failed to add standard packages."
    fi
fi

if [ ${#dev_packages_to_add[@]} -gt 0 ]; then
    echo ""
    info "Adding ${#dev_packages_to_add[@]} dev_dependencies package(s)..."
    if flutter pub add --dev "${dev_packages_to_add[@]}"; then
        success "Dev packages added successfully!"
    else
        error "Failed to add dev packages."
    fi
fi
