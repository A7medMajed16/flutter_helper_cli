#!/bin/bash
# ============================================================
#  add-dependencies — Interactive CLI to add Flutter packages
#  Run from any Dart/Flutter project directory.
# ============================================================

set -e

# ── Colors ──────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

info()    { echo -e "${CYAN}ℹ ${NC}$1"; }
success() { echo -e "${GREEN}✅ ${NC}$1"; }
warn()    { echo -e "${YELLOW}⚠️  ${NC}$1"; }
error()   { echo -e "${RED}❌ ${NC}$1"; exit 1; }

targetPath="${PWD}"

# Check if we are in a Flutter project
if [ ! -f "$targetPath/pubspec.yaml" ]; then
    error "No pubspec.yaml found. Please run this command at the root of a Flutter project."
fi

# Item types:
#   C = category header
#   R = required (always added, can't be unchecked, shown as red *)
#   I = dependency      D = dev_dependency
#   O = optional core feature: "O|package|feature", unchecked by default.
#       When ALL packages of a feature are selected, its code in lib/core
#       (blocks marked //#optional:<feature>) is uncommented automatically.
items=(
    "C|Design System (required — Flutter 3.50+)"
    "R|material_ui"
    "R|cupertino_ui"

    "C|Architecture & State Management"
    "I|bloc"
    "I|flutter_bloc"
    "I|get_it"
    "I|injectable"
    "D|build_runner"
    "D|injectable_generator"

    "C|Networking & Data"
    "I|dio"
    "I|pretty_dio_logger"
    "I|shared_preferences"
    "I|flutter_secure_storage"
    "I|freezed_annotation"
    "I|json_annotation"
    "D|freezed"
    "D|json_serializable"

    "C|Navigation & Routing"
    "I|auto_route"
    "D|auto_route_generator"

    "C|UI & Assets"
    "I|cached_network_image"
    "I|flutter_cache_manager"
    "I|flutter_screenutil"
    "I|flutter_svg"
    "I|shimmer"
    "I|toastification"
    "I|liquid_pull_to_refresh"
    "I|lottie"
    "I|cupertino_icons"
    "I|vibration"
    "I|sliver_tools"
    "I|package_info_plus"

    "C|Media & Files"
    "I|image"
    "I|image_picker"
    "I|image_cropper"
    "I|file_picker"
    "O|video_player|video"
    "O|chewie|video"
    "I|just_audio"

    "C|Utilities & Platform"
    "I|dartz"
    "I|equatable"
    "I|easy_localization"
    "I|path"
    "I|path_provider"
    "I|permission_handler"
    "I|url_launcher"
    "I|share_plus"
    "I|pinput"
    "I|table_calendar"
    "I|logo_motion"
    "O|hijri|hijri"
    "I|ntp"

    "C|Location & Maps (optional — enables core location code)"
    "O|geolocator|location"
    "O|geocoding|location"
    "O|latlong2|location"
    "O|map_launcher|location"


    "C|Environment & Tooling"
    "I|flutter_dotenv"
    "I|flutter_launcher_icons"
    "I|flutter_native_splash"
    "I|flutter_local_notifications"
    "I|flutter_lints"
    "D|flutter_gen_runner"

    "C|Firebase"
    "I|firebase_core"
    "I|firebase_messaging"
    "I|firebase_remote_config"

    "C|Config"
    "I|foundation"

    "C|Background Tasks"
    "I|flutter_foreground_task"
)

is_selectable() {
    [[ "$1" == "I|"* ]] || [[ "$1" == "D|"* ]] || [[ "$1" == "R|"* ]] || [[ "$1" == "O|"* ]]
}

selected=()
for i in "${!items[@]}"; do
    if [[ "${items[$i]}" == "O|"* ]]; then
        selected[$i]=0
    elif is_selectable "${items[$i]}"; then
        selected[$i]=1
    else
        selected[$i]=0
    fi
done

cursor=1

move_cursor() {
    local dir=$1
    local new_cursor=$cursor
    while true; do
        new_cursor=$((new_cursor + dir))
        if [ $new_cursor -lt 0 ] || [ $new_cursor -ge ${#items[@]} ]; then
            break
        fi
        if is_selectable "${items[$new_cursor]}"; then
            cursor=$new_cursor
            break
        fi
    done
}

render_menu() {
    # Dynamically compute visible window from terminal height
    local term_lines
    term_lines=$(tput lines 2>/dev/null || echo 24)
    # Reserve lines for: header(1) + top indicator(1) + bottom indicator(1)
    local max_items=$((term_lines - 3))
    if [ "$max_items" -lt 3 ]; then max_items=3; fi
    if [ "$max_items" -gt ${#items[@]} ]; then max_items=${#items[@]}; fi

    local start_idx=0
    local end_idx=$max_items

    if [ ${#items[@]} -gt "$max_items" ]; then
        # Center the window on the cursor where possible
        start_idx=$((cursor - max_items / 2))
        if [ "$start_idx" -lt 0 ]; then
            start_idx=0
        fi
        end_idx=$((start_idx + max_items))
        if [ "$end_idx" -gt ${#items[@]} ]; then
            end_idx=${#items[@]}
            start_idx=$((end_idx - max_items))
        fi
    fi

    # Always jump to top-left of screen and redraw everything
    tput cup 0 0

    # Re-print header
    echo -e "${BOLD}Select packages to add (Space to toggle, Enter to confirm, Up/Down to move):${NC}\033[K"

    if [ "$start_idx" -gt 0 ]; then
        echo -e "  ${CYAN}↑ ...more above...${NC}\033[K"
    else
        echo -e "\033[K"
    fi

    for (( i=$start_idx; i<$end_idx; i++ )); do
        IFS="|" read -r type name feature <<< "${items[$i]}"
        if [ "$type" == "C" ]; then
            echo -e "${BOLD}${CYAN}--- $name ---${NC}\033[K"
        else
            local check=" "
            local tag=""
            if [ "$type" == "R" ]; then
                check="${RED}*${NC}"
                tag="${RED}(required)"
            elif [ "${selected[$i]}" -eq 1 ]; then
                check="${GREEN}✓${NC}"
            fi
            if [ "$type" == "D" ]; then
                tag="(dev)"
            elif [ "$type" == "O" ]; then
                tag="${CYAN}(optional: ${feature})"
            fi
            if [ "$i" -eq "$cursor" ]; then
                echo -e "${GREEN}> [${check}${GREEN}] $name${YELLOW} ${tag} ${NC}\033[K"
            else
                echo -e "  [${check}] $name${YELLOW} ${tag} ${NC}\033[K"
            fi
        fi
    done

    if [ "$end_idx" -lt ${#items[@]} ]; then
        echo -e "  ${CYAN}↓ ...more below...${NC}\033[K"
    else
        echo -e "\033[K"
    fi

    # Clear everything below to remove stale lines
    echo -en "\033[J"
}

# Cleanup: restore cursor and exit alternate screen
cleanup() {
    tput cnorm 2>/dev/null
    tput rmcup 2>/dev/null
}
trap cleanup EXIT

# Enter alternate screen buffer (like vim/fzf) — gives us a clean screen
tput smcup
tput civis
tput clear

while true; do
    render_menu

    IFS= read -rsn1 key

    if [[ $key == $'\x1b' ]]; then
        read -rsn2 key2
        if [[ $key2 == "[A" ]]; then
            move_cursor -1
        elif [[ $key2 == "[B" ]]; then
            move_cursor 1
        fi
    elif [[ "$key" == "" ]]; then
        break
    elif [[ "$key" == " " ]]; then
        # Required packages can't be unchecked
        if [[ "${items[$cursor]}" == "R|"* ]]; then
            continue
        fi
        if [ "${selected[$cursor]}" -eq 1 ]; then
            selected[$cursor]=0
        else
            selected[$cursor]=1
        fi
    fi
done

packages_to_add=()
dev_packages_to_add=()
for i in "${!items[@]}"; do
    IFS="|" read -r type name feature <<< "${items[$i]}"
    if [ "${selected[$i]}" -eq 1 ]; then
        if [ "$type" == "I" ] || [ "$type" == "R" ] || [ "$type" == "O" ]; then
            packages_to_add+=("$name")
        elif [ "$type" == "D" ]; then
            dev_packages_to_add+=("$name")
        fi
    fi
done

echo ""
if [ ${#packages_to_add[@]} -eq 0 ] && [ ${#dev_packages_to_add[@]} -eq 0 ]; then
    warn "No packages selected."
    exit 0
fi

if [ ${#packages_to_add[@]} -gt 0 ]; then
    info "Adding ${#packages_to_add[@]} standard package(s)..."
    if flutter pub add "${packages_to_add[@]}"; then
        success "Standard packages added successfully!"
    else
        error "Failed to add standard packages."
    fi
fi

if [ ${#dev_packages_to_add[@]} -gt 0 ]; then
    echo ""
    info "Adding ${#dev_packages_to_add[@]} dev_dependencies package(s)..."
    if flutter pub add --dev "${dev_packages_to_add[@]}"; then
        success "Dev packages added successfully!"
    else
        error "Failed to add dev packages."
    fi
fi

# ── Optional core features ──────────────────────────────────
# Uncomment the //#optional:<feature> blocks in lib/core for every feature
# whose packages were all selected. The start marker is renamed to
# //#optional-enabled:<feature> so running this again never double-uncomments.
enable_feature() {
    local feature=$1
    local coreDir="$targetPath/lib/core"
    [ -d "$coreDir" ] || return 0
    local files
    files=$(grep -rlF --include='*.dart' "//#optional:$feature" "$coreDir" || true)
    if [ -z "$files" ]; then
        info "Feature ${BOLD}$feature${NC}: no commented code to enable (already enabled?)"
        return 0
    fi
    while IFS= read -r file; do
        START="//#optional:$feature" END="//#end-optional:$feature" perl -i -pe '
            if (/^\s*\Q$ENV{START}\E\s*$/) { $in = 1; s/#optional:/#optional-enabled:/; next }
            if (/^\s*\Q$ENV{END}\E\s*$/)   { $in = 0; next }
            s{^(\s*)// ?}{$1} if $in;
        ' "$file"
        success "Enabled ${BOLD}$feature${NC} in ${file#$targetPath/}"
    done <<< "$files"
}

features=""
for i in "${!items[@]}"; do
    IFS="|" read -r type name feature <<< "${items[$i]}"
    if [ "$type" == "O" ]; then
        case " $features " in
            *" $feature "*) ;;
            *) features="$features $feature" ;;
        esac
    fi
done

for feature in $features; do
    total=0
    picked=0
    missing=""
    for i in "${!items[@]}"; do
        IFS="|" read -r type name f <<< "${items[$i]}"
        if [ "$type" == "O" ] && [ "$f" == "$feature" ]; then
            total=$((total + 1))
            if [ "${selected[$i]}" -eq 1 ]; then
                picked=$((picked + 1))
            else
                missing="$missing $name"
            fi
        fi
    done
    if [ "$picked" -eq "$total" ]; then
        echo ""
        enable_feature "$feature"
    elif [ "$picked" -gt 0 ]; then
        echo ""
        warn "Feature ${BOLD}$feature${NC} stays commented out in lib/core — also select:${BOLD}$missing${NC}"
    fi
done
