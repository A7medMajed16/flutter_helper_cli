#!/bin/bash

# ============================================================
#  flutter-release — Global Flutter APK release & Telegram sender
#  Run from any Flutter project directory.
# ============================================================

set -e

# ── Parse flags ─────────────────────────────────────────────
BUILD_AAB=false
for arg in "$@"; do
    case $arg in
        --aab)
            BUILD_AAB=true
            ;;
    esac
done

# ── Colors ──────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ── Helpers ─────────────────────────────────────────────────
info()    { echo -e "${CYAN}ℹ ${NC}$1"; }
success() { echo -e "${GREEN}✅ ${NC}$1"; }
warn()    { echo -e "${YELLOW}⚠️  ${NC}$1"; }
error()   { echo -e "${RED}❌ ${NC}$1"; exit 1; }

# ── Config file path ────────────────────────────────────────
CONFIG_FILE="$HOME/.flutter-release.env"

# ── Check: are we in a Flutter project? ─────────────────────
if [ ! -f "pubspec.yaml" ]; then
    error "No pubspec.yaml found. Run this command from inside a Flutter project directory."
fi

# ── Read project name ──────────────────────────────────────
PROJECT_NAME=$(grep -m1 '^name:' pubspec.yaml | sed 's/name:[[:space:]]*//' | tr -d '[:space:]' | tr -d '"' | tr -d "'")
if [ -z "$PROJECT_NAME" ]; then
    error "Could not read project name from pubspec.yaml"
fi

# ── Read current version ───────────────────────────────────
CURRENT_VERSION_LINE=$(grep -m1 '^version:' pubspec.yaml)
if [ -z "$CURRENT_VERSION_LINE" ]; then
    error "Could not find version in pubspec.yaml"
fi

# Parse version (e.g. "version: 1.2.3+4")
FULL_VERSION=$(echo "$CURRENT_VERSION_LINE" | sed 's/version:[[:space:]]*//' | tr -d '[:space:]')
VERSION_PART=$(echo "$FULL_VERSION" | cut -d'+' -f1)
BUILD_PART=$(echo "$FULL_VERSION" | cut -d'+' -f2)

MAJOR=$(echo "$VERSION_PART" | cut -d'.' -f1)
MINOR=$(echo "$VERSION_PART" | cut -d'.' -f2)
PATCH=$(echo "$VERSION_PART" | cut -d'.' -f3)

# Default build number if not present
if [ "$BUILD_PART" = "$VERSION_PART" ]; then
    BUILD_PART=1
fi

echo ""
echo -e "${BOLD}╔══════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║       🚀 Flutter Release Builder 🚀         ║${NC}"
echo -e "${BOLD}╚══════════════════════════════════════════════╝${NC}"
echo ""
echo -e "  📦 Project:  ${BOLD}${PROJECT_NAME}${NC}"
echo -e "  📌 Version:  ${BOLD}${VERSION_PART}${NC} (build ${BUILD_PART})"
echo ""

# ── Prompt for change type (multi-select) ───────────────────
echo -e "${BOLD}What type of changes are included?${NC}"
echo -e "  ${CYAN}You can select multiple — e.g. type ${BOLD}1,2${NC}${CYAN} for bug fix + UI change${NC}"
echo ""
echo -e "  ${GREEN}0)${NC} 🔄 No version change        →  rebuild & send as-is"
echo -e "  ${GREEN}1)${NC} 🐛 Bug fix / small change   →  patch +1"
echo -e "  ${GREEN}2)${NC} 🎨 UI change                →  minor +1"
echo -e "  ${GREEN}3)${NC} ✨ New feature               →  major +1"
echo ""
read -p "$(echo -e ${BOLD}"Choose (e.g. 0 or 1 or 1,2 or 1,2,3): "${NC})" CHOICES

SKIP_VERSION_BUMP=false
HAS_BUGFIX=false
HAS_UI=false
HAS_FEATURE=false
CHANGE_LABELS=()

# Parse comma-separated choices
IFS=',' read -ra CHOICE_ARRAY <<< "$CHOICES"
for CHOICE in "${CHOICE_ARRAY[@]}"; do
    CHOICE=$(echo "$CHOICE" | tr -d '[:space:]')
    case $CHOICE in
        0)
            SKIP_VERSION_BUMP=true
            CHANGE_LABELS+=("🔄 Rebuild")
            ;;
        1)
            HAS_BUGFIX=true
            CHANGE_LABELS+=("🐛 Bug fix")
            ;;
        2)
            HAS_UI=true
            CHANGE_LABELS+=("🎨 UI change")
            ;;
        3)
            HAS_FEATURE=true
            CHANGE_LABELS+=("✨ New feature")
            ;;
        *)
            error "Invalid choice: ${CHOICE}. Please select 0, 1, 2, or 3."
            ;;
    esac
done

if [ ${#CHANGE_LABELS[@]} -eq 0 ]; then
    error "No change type selected."
fi

# Apply version bumps (skip if option 0)
if [ "$SKIP_VERSION_BUMP" = false ]; then
    if [ "$HAS_FEATURE" = true ]; then
        MAJOR=$((MAJOR + 1))
    fi
    if [ "$HAS_UI" = true ]; then
        MINOR=$((MINOR + 1))
    fi
    if [ "$HAS_BUGFIX" = true ]; then
        PATCH=$((PATCH + 1))
    fi
fi

# Build change label string
CHANGE_LABEL=$(IFS=', '; echo "${CHANGE_LABELS[*]}")

# ── Prompt for release notes (multi-line) ─────────────────
echo ""
echo -e "${BOLD}Add notes (one line each, empty line to finish / skip):${NC}"
RELEASE_NOTES=""
while IFS= read -r NOTE_LINE; do
    [ -z "$NOTE_LINE" ] && break
    if [ -z "$RELEASE_NOTES" ]; then
        RELEASE_NOTES="$NOTE_LINE"
    else
        RELEASE_NOTES="${RELEASE_NOTES}
${NOTE_LINE}"
    fi
done

# ── Ask for build environment (default: Live) ─────────────
echo ""
echo -e "${BOLD}Build environment?${NC}"
echo -e "  ${GREEN}1)${NC} 🟢 Live"
echo -e "  ${GREEN}2)${NC} 📍 Local"
echo -e "  ${GREEN}3)${NC} 🧪 Live Test"
echo ""
read -p "$(echo -e ${BOLD}"Choose (1/2/3) [1]: "${NC})" BUILD_ENV_CHOICE
BUILD_ENV_CHOICE=${BUILD_ENV_CHOICE:-1}

case $BUILD_ENV_CHOICE in
    1) BUILD_ENV="🟢 Live" ;;
    2) BUILD_ENV="📍 Local" ;;
    3) BUILD_ENV="🧪 Live Test" ;;
    *) error "Invalid choice: ${BUILD_ENV_CHOICE}. Please select 1, 2, or 3." ;;
esac

# ── Ask about git commit (before build) ────────────────────
GIT_COMMIT="n"
if [ "$SKIP_VERSION_BUMP" = false ]; then
    echo ""
    read -p "$(echo -e ${BOLD}"Commit version bump to git? (y/n): "${NC})" GIT_COMMIT
fi

NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"
NEW_BUILD=$((BUILD_PART + 1))
NEW_FULL_VERSION="${NEW_VERSION}+${NEW_BUILD}"

if [ "$SKIP_VERSION_BUMP" = false ]; then
    echo ""
    info "Version: ${BOLD}${VERSION_PART}${NC} → ${BOLD}${NEW_VERSION}${NC} (build ${NEW_BUILD})"
    echo ""

    # ── Update pubspec.yaml ────────────────────────────────────
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' "s/^version: .*/version: ${NEW_FULL_VERSION}/" pubspec.yaml
    else
        sed -i "s/^version: .*/version: ${NEW_FULL_VERSION}/" pubspec.yaml
    fi
    success "Updated pubspec.yaml → version: ${NEW_FULL_VERSION}"
else
    echo ""
    info "Building with current version: ${BOLD}${VERSION_PART}${NC} (no version bump)"
    echo ""
fi

# ── Clean & get dependencies ───────────────────────────────
info "Cleaning project..."
flutter clean
echo ""
info "Getting dependencies..."
flutter pub get
echo ""

# ── Build ──────────────────────────────────────────────────

if [ "$BUILD_AAB" = true ]; then
    # Clear and recreate releases folder for AAB
    rm -rf releases
    mkdir -p releases

    info "Building AAB... (this may take a few minutes)"
    echo ""
    flutter build appbundle --release

    AAB_SOURCE="build/app/outputs/bundle/release/app-release.aab"
    if [ ! -f "$AAB_SOURCE" ]; then
        error "AAB not found at ${AAB_SOURCE}. Build may have failed."
    fi

    AAB_NAME="${PROJECT_NAME}_${NEW_VERSION}.aab"
    cp "$AAB_SOURCE" "releases/${AAB_NAME}"
    success "AAB saved: ${BOLD}releases/${AAB_NAME}${NC}"
    TELEGRAM_FILE="releases/${AAB_NAME}"
else
    mkdir -p releases

    info "Building APK with split-per-abi... (this may take a few minutes)"
    echo ""
    flutter build apk --release --split-per-abi

    APK_DIR="build/app/outputs/flutter-apk"
    ARM64_APK="${APK_DIR}/app-arm64-v8a-release.apk"
    ARMV7_APK="${APK_DIR}/app-armeabi-v7a-release.apk"
    X86_APK="${APK_DIR}/app-x86_64-release.apk"

    APK_COUNT=0
    if [ -f "$ARM64_APK" ]; then
        APK_NAME="${PROJECT_NAME}_${NEW_VERSION}_arm64.apk"
        cp "$ARM64_APK" "releases/${APK_NAME}"
        success "APK saved: ${BOLD}releases/${APK_NAME}${NC}"
        TELEGRAM_FILE="releases/${APK_NAME}"
        APK_COUNT=$((APK_COUNT + 1))
    fi
    if [ -f "$ARMV7_APK" ]; then
        ARMV7_NAME="${PROJECT_NAME}_${NEW_VERSION}_armv7.apk"
        cp "$ARMV7_APK" "releases/${ARMV7_NAME}"
        success "APK saved: ${BOLD}releases/${ARMV7_NAME}${NC}"
        APK_COUNT=$((APK_COUNT + 1))
    fi
    if [ -f "$X86_APK" ]; then
        X86_NAME="${PROJECT_NAME}_${NEW_VERSION}_x86_64.apk"
        cp "$X86_APK" "releases/${X86_NAME}"
        success "APK saved: ${BOLD}releases/${X86_NAME}${NC}"
        APK_COUNT=$((APK_COUNT + 1))
    fi

    if [ $APK_COUNT -eq 0 ]; then
        error "No APKs found in ${APK_DIR}. Build may have failed."
    fi

    if [ -z "$TELEGRAM_FILE" ]; then
        TELEGRAM_FILE="releases/${ARMV7_NAME:-${X86_NAME}}"
    fi
fi

# ── Send to Telegram ───────────────────────────────────────
if [ ! -f "$CONFIG_FILE" ]; then
    warn "Config file not found. Creating ${CONFIG_FILE}..."
    cat > "$CONFIG_FILE" << 'EOF'
# Flutter Release — Telegram Config
# Get your bot token from @BotFather on Telegram
# Get your chat ID by adding @userinfobot to your group

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
EOF
    chmod 600 "$CONFIG_FILE"
    echo ""
    warn "Please edit ${BOLD}~/.flutter-release.env${NC} with your Telegram bot token and chat ID."
    warn "Then run ${BOLD}flutter-release${NC} again."
    echo ""
    echo -e "  ${CYAN}nano ~/.flutter-release.env${NC}"
    echo ""
    exit 0
fi

# Source config
source "$CONFIG_FILE"

if [ "$TELEGRAM_BOT_TOKEN" = "your_bot_token_here" ] || [ -z "$TELEGRAM_BOT_TOKEN" ]; then
    warn "Telegram bot token not configured. Edit ${BOLD}~/.flutter-release.env${NC}"
    warn "Build was successful but not sent to Telegram."
    exit 0
fi

if [ "$TELEGRAM_CHAT_ID" = "your_chat_id_here" ] || [ -z "$TELEGRAM_CHAT_ID" ]; then
    warn "Telegram chat ID not configured. Edit ${BOLD}~/.flutter-release.env${NC}"
    warn "APK was built successfully but not sent to Telegram."
    exit 0
fi

info "Sending to Telegram..."

# Escape Telegram HTML special chars in free text
escape_html() {
    printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

CAPTION="🚀 <b>$(escape_html "$PROJECT_NAME")</b> v${NEW_VERSION}
📝 $(escape_html "$CHANGE_LABEL")
🔢 Build: ${NEW_BUILD}"

# Append notes if provided (preserve multi-line)
if [ -n "$RELEASE_NOTES" ]; then
    CAPTION="${CAPTION}
📋 Notes:
$(escape_html "$RELEASE_NOTES")"
fi

# Append build environment
CAPTION="${CAPTION}
⚙️ Env: ${BUILD_ENV}"

# Telegram limits: document caption 1024, message text 4096
CAPTION_LEN=${#CAPTION}

if [ "$BUILD_AAB" = true ]; then
    # AAB: send text notification only (file too large for Telegram)
    CAPTION="${CAPTION}
📦 AAB is ready for Play Store upload"

    RESPONSE=$(curl -s -X POST \
        "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -F "chat_id=${TELEGRAM_CHAT_ID}" \
        --form-string "text=${CAPTION}" \
        -F "parse_mode=HTML") || RESPONSE='{"ok":false,"description":"Telegram request failed"}'
else
    # APK: send the file (+ notes as separate message if caption too long)
    if [ "$CAPTION_LEN" -gt 1024 ]; then
        SHORT_CAPTION="🚀 <b>$(escape_html "$PROJECT_NAME")</b> v${NEW_VERSION}
📝 $(escape_html "$CHANGE_LABEL")
🔢 Build: ${NEW_BUILD}
⚙️ Env: ${BUILD_ENV}"

        RESPONSE=$(curl -s -X POST \
            "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendDocument" \
            -F "chat_id=${TELEGRAM_CHAT_ID}" \
            -F "document=@${TELEGRAM_FILE}" \
            --form-string "caption=${SHORT_CAPTION}" \
            -F "parse_mode=HTML") || RESPONSE='{"ok":false,"description":"Telegram request failed"}'

        if echo "$RESPONSE" | grep -q '"ok":true' && [ -n "$RELEASE_NOTES" ]; then
            NOTES_MSG="📋 <b>Notes</b> — <b>$(escape_html "$PROJECT_NAME")</b> v${NEW_VERSION}
$(escape_html "$RELEASE_NOTES")"
            curl -s -X POST \
                "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
                -F "chat_id=${TELEGRAM_CHAT_ID}" \
                --form-string "text=${NOTES_MSG}" \
                -F "parse_mode=HTML" >/dev/null || true
        fi
    else
        RESPONSE=$(curl -s -X POST \
            "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendDocument" \
            -F "chat_id=${TELEGRAM_CHAT_ID}" \
            -F "document=@${TELEGRAM_FILE}" \
            --form-string "caption=${CAPTION}" \
            -F "parse_mode=HTML") || RESPONSE='{"ok":false,"description":"Telegram request failed"}'
    fi
fi

# Check if Telegram API returned success
if echo "$RESPONSE" | grep -q '"ok":true'; then
    success "Sent to Telegram! 🎉"
else
    ERROR_MSG=$(echo "$RESPONSE" | grep -o '"description":"[^"]*"' | sed 's/"description":"//' | sed 's/"//')
    warn "Failed to send to Telegram: ${ERROR_MSG}"
fi

# ── Delete releases folder (APK only) ──────────────────────
if [ "$BUILD_AAB" = false ]; then
    echo ""
    info "Removing releases folder..."
    rm -rf releases
    success "Releases folder removed"
fi

# ── Cleanup build artifacts ────────────────────────────────
echo ""
info "Cleaning up build files..."
if flutter clean && flutter pub get; then
    success "Build files cleaned up"
else
    warn "Build cleanup failed; release was still created."
fi

# ── Git commit & push (if user said yes) ───────────────────
if [ "$GIT_COMMIT" = "y" ] || [ "$GIT_COMMIT" = "Y" ]; then
    git add pubspec.yaml
    git commit -m "🔖 bump version to ${NEW_VERSION}"
    success "Committed version bump to git"
    git push
    success "Pushed to remote"
fi

echo ""
echo -e "${BOLD}╔══════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║             🎉 Release Complete! 🎉          ║${NC}"
echo -e "${BOLD}╚══════════════════════════════════════════════╝${NC}"
echo ""
echo -e "  📦 Project:  ${BOLD}${PROJECT_NAME}${NC}"
echo -e "  📌 Version:  ${BOLD}${NEW_VERSION}${NC} (build ${NEW_BUILD})"
echo -e "  📝 Change:   ${CHANGE_LABEL}"
echo -e "  📁 File:      ${BOLD}${TELEGRAM_FILE}${NC}"
echo ""
